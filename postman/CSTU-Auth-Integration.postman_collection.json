{
  "info": {
    "_postman_id": "cstu-auth-integration-person1",
    "name": "CSTU Auth Integration (Person 1)",
    "description": "Integration tests for Authentication & Access — INT-AUTH-01 .. INT-AUTH-08.\n\nUsage:\n1. Start the Spring Boot backend: `./mvnw.cmd spring-boot:run` (defaults to http://localhost:8081).\n2. Import environment `CSTU-Auth-Local.postman_environment.json`.\n3. Fill in `validUsername` / `validPassword` (and optionally `specialUsername` / `normalUsername`) with real TU credentials before running INT-AUTH-01 / INT-AUTH-07 / INT-AUTH-08.\n4. Run the collection (or `newman run ...`). All assertions appear in the Test Results tab.\n\nRequests that DO NOT need real credentials: 02, 03, 04, 05, 06 (negative paths).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level pre-request: generate a fresh expired JWT signed with the",
          "// configured jwt.secret so INT-AUTH-06 can exercise the expired-token branch",
          "// without depending on a hand-baked token. If jwtSecret is empty, we skip.",
          "const secret = pm.environment.get('jwtSecret') || pm.collectionVariables.get('jwtSecret');",
          "if (secret && typeof CryptoJS !== 'undefined') {",
          "  const header = { alg: 'HS256', typ: 'JWT' };",
          "  const nowSec = Math.floor(Date.now() / 1000);",
          "  const payload = { sub: 'expired-user', iat: nowSec - 600, exp: nowSec - 10 };",
          "  function b64url(str) {",
          "    return CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(str))",
          "      .replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "  }",
          "  const h = b64url(JSON.stringify(header));",
          "  const p = b64url(JSON.stringify(payload));",
          "  const signingInput = h + '.' + p;",
          "  const sigWordArray = CryptoJS.HmacSHA256(signingInput, secret);",
          "  const sig = CryptoJS.enc.Base64.stringify(sigWordArray)",
          "    .replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "  pm.environment.set('expiredToken', signingInput + '.' + sig);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "INT-AUTH-01 Login success with valid credential",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{validUsername}}\",\n  \"password\": \"{{validPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Response has non-empty token', () => {",
              "  pm.expect(body.token).to.be.a('string').and.not.empty;",
              "});",
              "pm.test('Response echoes username', () => {",
              "  pm.expect(body.username).to.equal(pm.environment.get('validUsername'));",
              "});",
              "pm.test('Message indicates success', () => {",
              "  pm.expect(body.message).to.include('สำเร็จ');",
              "});",
              "// Save token for later requests (INT-AUTH-07)",
              "pm.environment.set('token', body.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "INT-AUTH-02 Login fail with invalid password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{validUsername}}\",\n  \"password\": \"definitely-wrong-password-xyz\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401 Unauthorized', () => pm.response.to.have.status(401));",
              "const body = pm.response.json();",
              "pm.test('No token is issued', () => {",
              "  pm.expect(body.token === null || body.token === undefined).to.be.true;",
              "});",
              "pm.test('Error message present', () => {",
              "  pm.expect(body.message).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "INT-AUTH-03 Login fail with missing username or password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 4xx (no auth)', () => {",
              "  pm.expect(pm.response.code).to.be.within(400, 499);",
              "});",
              "pm.test('No token issued', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.token === null || body.token === undefined).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "INT-AUTH-04 Protected route access without token",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/coursesN",
          "host": ["{{baseUrl}}"],
          "path": ["api", "coursesN"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401 or 403', () => {",
              "  pm.expect([401, 403]).to.include(pm.response.code);",
              "});",
              "pm.test('Response body is not the course list', () => {",
              "  // when blocked, body is either empty or an error object — never a JSON array of courses",
              "  try {",
              "    const body = pm.response.json();",
              "    pm.expect(Array.isArray(body)).to.be.false;",
              "  } catch (e) { /* empty body is fine */ }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "INT-AUTH-05 Protected route access with malformed token",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer this.is.not-a-valid-jwt" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/coursesN",
          "host": ["{{baseUrl}}"],
          "path": ["api", "coursesN"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401 or 403', () => {",
              "  pm.expect([401, 403]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "INT-AUTH-06 Session expired handling",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{expiredToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/coursesN",
          "host": ["{{baseUrl}}"],
          "path": ["api", "coursesN"]
        },
        "description": "Uses an expired JWT auto-generated by the collection pre-request script. Requires `jwtSecret` env var."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('expiredToken was generated by pre-request', () => {",
              "  pm.expect(pm.environment.get('expiredToken')).to.be.a('string').and.not.empty;",
              "});",
              "pm.test('Status is 401 or 403', () => {",
              "  pm.expect([401, 403]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "INT-AUTH-07a Access protected route WITH valid token",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/coursesN",
          "host": ["{{baseUrl}}"],
          "path": ["api", "coursesN"]
        },
        "description": "Sanity check before simulating logout. Requires INT-AUTH-01 to have run and saved `{{token}}`."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "INT-AUTH-07b After logout (token removed) access is blocked",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/coursesN",
          "host": ["{{baseUrl}}"],
          "path": ["api", "coursesN"]
        },
        "description": "Simulates the frontend logout which clears localStorage: the next call has no Authorization header."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Simulate logout: forget the token",
              "pm.environment.unset('token');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401 or 403 (access revoked)', () => {",
              "  pm.expect([401, 403]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "INT-AUTH-08a Login special program (65) returns username",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{specialUsername}}\",\n  \"password\": \"{{specialPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        },
        "description": "Backend contract: username carries program code. Frontend login.js uses substring(4,6) to decide redirect target (65 -> main.html)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('specialUsername')) {",
              "  pm.test.skip('specialUsername not set — skipping', () => {});",
              "  return;",
              "}",
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Username is carried back unchanged', () => {",
              "  pm.expect(body.username).to.equal(pm.environment.get('specialUsername'));",
              "});",
              "pm.test('Program code (char 5–6) is 65', () => {",
              "  pm.expect(body.username.substring(4, 6)).to.equal('65');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "INT-AUTH-08b Login normal program (61) returns username",
      "request": {
